// Prisma Schema for Vaani AI Multi-Tenant SaaS

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum IntegrationProvider {
  VOBIZ
  SARVAM
  OPENAI
  CARTESIA
  POSTGRESQL
  DEEPGRAM
  GROQ
  LIVEKIT
}

enum IntegrationStatus {
  CONNECTED
  NOT_CONNECTED
  ERROR
}

enum AgentLanguage {
  TELUGU
  TELUGU_ENGLISH
  ENGLISH
}

enum CallEventType {
  CALL_STARTED
  CALL_CONNECTED
  STT_PARTIAL
  STT_FINAL
  LLM_FIRST_TOKEN
  LLM_COMPLETE
  TTS_FIRST_BYTE
  TTS_COMPLETE
  TOOL_CALL_START
  TOOL_CALL_END
  BARGE_IN
  CALL_ENDING
  CALL_ENDED
  ERROR
  FALLBACK_TRIGGERED
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  DRAFT
  ARCHIVED
}

enum CallDirection {
  INBOUND
  OUTBOUND
}

enum CallStatus {
  INITIALIZING
  CONNECTING
  ACTIVE
  LISTENING
  THINKING
  SPEAKING
  INTERRUPTED
  ENDING
  COMPLETED
  FAILED
}

enum CampaignStatus {
  DRAFT
  READY
  RUNNING
  PAUSED
  STOPPED
  COMPLETED
  FAILED
}

enum LeadStatus {
  PENDING
  QUEUED
  DIALING
  CONNECTED
  COMPLETED
  FAILED
  RETRYING
  SKIPPED
}

enum MessageRole {
  CALLER
  AI
  SYSTEM
  TOOL
}

model Organization {
  id              String            @id @default(cuid())
  name            String
  slug            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  users           User[]
  agents          Agent[]
  phoneNumbers    PhoneNumber[]
  integrations    Integration[]
  calls           Call[]
  businessProfile BusinessProfile?
  businesses      Business[]
  pricingRules    ProviderPricing[]
  customers       Customer[]
  orders          Order[]
  agentVersions   AgentVersion[]
  campaigns       Campaign[]

  @@index([slug])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  email          String       @unique
  name           String?
  role           Role         @default(MEMBER)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model BusinessProfile {
  id              String       @id @default(cuid())
  organizationId  String       @unique
  businessName    String
  description     String?      @db.Text
  productsServices String?     @db.Text
  workingHours    String?
  location        String?
  contactInfo     String?
  faqs            Json?        // List of { question: string, answer: string }
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Integration {
  id              String              @id @default(cuid())
  organizationId  String
  provider        IntegrationProvider
  status          IntegrationStatus   @default(NOT_CONNECTED)
  apiKeyMasked    String?             // Only masked preview (e.g. sk_car_•••••2ujU)
  secretMasked    String?
  config          Json?               // Store non-sensitive metadata (e.g., default voice ID, endpoints)
  lastCheckedAt   DateTime?
  errorMessage    String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, provider])
  @@index([organizationId])
}

model Agent {
  id               String        @id @default(cuid())
  organizationId   String
  name             String
  description      String?
  instructions     String?       @db.Text
  language         AgentLanguage @default(TELUGU_ENGLISH)
  status           AgentStatus   @default(ACTIVE)
  systemPrompt     String        @db.Text
  businessContext  String?       @db.Text
  voiceId          String?       // Cartesia voice UUID for TTS
  cartesiaVoiceId  String?       // Legacy alias — use voiceId
  cartesiaAgentId  String?       // Deprecated: Cartesia Agent ID (agent_xxx) — will be removed
  ttsModel         String        @default("sonic-3.6")
  cartesiaModel    String        @default("sonic-3.6") // Legacy alias — use ttsModel
  llmModel         String        @default("gemini-2.5-flash")
  llmProvider      String        @default("groq") // groq, openai, google
  temperature      Float         @default(0.4)
  sttProvider      String        @default("deepgram") // deepgram, sarvam
  sttModel         String        @default("nova-3")
  sarvamModel      String        @default("saaras:v3-realtime")
  sarvamLanguage   String        @default("te-IN")
  phoneNumberId    String?       @unique
  businessId       String?
  initialMessage   String?       @db.Text
  currentVersionNum Int          @default(0) // Auto-incremented on each save
  // Legacy Cartesia sync fields — deprecated
  cartesiaVersionId String?
  lastSyncedAt     DateTime?
  lastSyncStatus   String?       @default("SYNCED")
  lastSyncError    String?       @db.Text
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber      PhoneNumber?  @relation(fields: [phoneNumberId], references: [id])
  business         Business?     @relation(fields: [businessId], references: [id])
  tools            AgentTool[]
  knowledge        AgentKnowledge[]
  calls            Call[]
  versions         AgentVersion[]
  campaigns        Campaign[]

  @@index([organizationId])
  @@index([cartesiaAgentId])
  @@index([organizationId, status])
  @@index([status])
}

model Business {
  id                 String       @id @default(cuid())
  organizationId     String
  name               String
  description        String?      @db.Text
  information        String?      @db.Text
  contactInformation String?
  operatingHours     String?
  address            String?
  website            String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agents             Agent[]

  @@index([organizationId])
}

model AgentKnowledge {
  id          String   @id @default(cuid())
  agentId     String
  title       String
  content     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([agentId, createdAt])
}

model AgentTool {
  id            String   @id @default(cuid())
  agentId       String
  name          String   // e.g. "end_call", "transfer_call", "capture_customer_details"
  description   String
  configuration Json?
  parameters    Json?
  enabled       Boolean  @default(true)
  isEnabled     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, name])
  @@index([agentId])
  @@index([agentId, isEnabled])
}

model PhoneNumber {
  id             String       @id @default(cuid())
  organizationId String
  e164Number     String       @unique // e.g. +918012345678
  provider       String       @default("Vobiz")
  status         String       @default("Active") // Active, Inactive, Pending
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAgent  Agent?

  @@index([organizationId])
}

model Call {
  id              String             @id @default(cuid())
  organizationId  String
  agentId         String?
  agentVersionId  String?            // Snapshot: which agent version was active at call start
  vobizCallId     String?            @unique
  streamId        String?
  livekitRoom     String?
  livekitParticipantId String?
  livekitSipCallId String?
  callerNumber    String
  agentNumber     String
  direction       CallDirection      @default(INBOUND)
  status          CallStatus         @default(INITIALIZING)
  pipelineType    String             @default("livekit") // livekit | cartesia_legacy
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationSeconds Int                @default(0)
  endReason       String?
  totalCost       Decimal            @default(0.0) @db.Decimal(10, 4)
  currency        String             @default("INR")
  recordingUrl    String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent           Agent?             @relation(fields: [agentId], references: [id], onDelete: SetNull)
  agentVersion    AgentVersion?      @relation(fields: [agentVersionId], references: [id], onDelete: SetNull)
  participants    CallParticipant[]
  transcripts     TranscriptMessage[]
  summary         CallSummary?
  usage           Usage?
  events          CallEvent[]

  @@index([organizationId])
  @@index([agentId])
  @@index([agentVersionId])
  @@index([startedAt])
  @@index([callerNumber])
  @@index([status])
  @@index([createdAt])
  @@index([organizationId, status])
}

model CallParticipant {
  id        String      @id @default(cuid())
  callId    String
  role      MessageRole
  identifier String     // Phone number or Agent Name
  createdAt DateTime    @default(now())

  call      Call        @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
}

model TranscriptMessage {
  id             String      @id @default(cuid())
  callId         String
  role           MessageRole
  content        String      @db.Text
  normalizedText String?     @db.Text
  timestampMs    Int         // Relative milliseconds since call start
  sttLatencyMs   Int?
  llmLatencyMs   Int?
  ttsLatencyMs   Int?
  wasInterrupted Boolean     @default(false)
  createdAt      DateTime    @default(now())

  call           Call        @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([timestampMs])
}

model CallSummary {
  id               String   @id @default(cuid())
  callId           String   @unique
  summary          String   @db.Text
  customerIntent   String?
  outcome          String?
  importantInfo    String?  @db.Text
  followUpRequired Boolean  @default(false)
  followUpDetails  String?
  capturedDetails  Json?    // e.g. { name: "Rajesh", requirement: "Enterprise demo", email: "..." }
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  call             Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model Usage {
  id              String   @id @default(cuid())
  callId          String   @unique
  durationSeconds Int      @default(0)
  sttAudioSeconds Float    @default(0.0)
  llmInputTokens  Int      @default(0)
  llmOutputTokens Int      @default(0)
  ttsCharacters   Int      @default(0)
  vobizCost       Decimal  @default(0.0) @db.Decimal(10, 4)
  sarvamCost      Decimal  @default(0.0) @db.Decimal(10, 4)
  openaiCost      Decimal  @default(0.0) @db.Decimal(10, 4)
  cartesiaCost    Decimal  @default(0.0) @db.Decimal(10, 4)
  infraCost       Decimal  @default(0.0) @db.Decimal(10, 4)
  totalCost       Decimal  @default(0.0) @db.Decimal(10, 4)
  currency        String   @default("INR")
  createdAt       DateTime @default(now())

  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
}

model ProviderPricing {
  id             String              @id @default(cuid())
  organizationId String
  provider       IntegrationProvider
  metricUnit     String              // "minute", "second", "1k_input_tokens", "1k_output_tokens", "1k_characters"
  rate           Decimal             @db.Decimal(10, 5)
  currency       String              @default("INR")
  effectiveDate  DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  phoneNumber    String
  name           String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, phoneNumber])
  @@index([organizationId])
  @@index([phoneNumber])
  @@index([createdAt])
}

model Order {
  id               String       @id @default(cuid())
  orderId          String       @unique // e.g. "4567", "ORD-8421"
  organizationId   String
  customerId       String?
  phoneNumber      String
  items            String
  status           String       // "In Transit", "Delivered", "Processing"
  courier          String?      // "Ekart Logistics", "BlueDart"
  expectedDelivery String?      // "Tomorrow (రేపు) by 2:00 PM"
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([orderId])
  @@index([phoneNumber])
  @@index([status])
  @@index([createdAt])
}

// ─── Agent Versioning (Immutable Snapshots) ────────────────────────────────
// Every agent save creates a new version. Calls pin to the version active at start.
// Editing an agent never breaks calls in progress.

model AgentVersion {
  id               String        @id @default(cuid())
  organizationId   String
  agentId          String
  versionNumber    Int           // Auto-incremented per agent
  name             String
  description      String?
  systemPrompt     String        @db.Text
  instructions     String?       @db.Text
  initialMessage   String?       @db.Text
  voiceId          String        // Cartesia TTS voice UUID
  ttsModel         String        @default("sonic-3.6")
  llmModel         String        @default("gemini-2.5-flash")
  llmProvider      String        @default("groq")
  temperature      Float         @default(0.4)
  sttProvider      String        @default("deepgram")
  sttModel         String        @default("nova-3")
  language         AgentLanguage @default(TELUGU_ENGLISH)
  businessContext  String?       @db.Text
  tools            Json?         // Snapshot of tools at this version
  knowledge        Json?         // Snapshot of knowledge at this version
  configSnapshot   Json?         // Full config snapshot for audit
  status           String        @default("LIVE") // LIVE, ARCHIVED
  createdAt        DateTime      @default(now())

  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent            Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  calls            Call[]

  @@unique([agentId, versionNumber])
  @@index([organizationId])
  @@index([agentId])
  @@index([agentId, status])
  @@index([agentId, versionNumber])
}

// ─── Call Events (Per-Stage Latency & Lifecycle Tracking) ───────────────────

model CallEvent {
  id            String        @id @default(cuid())
  callId        String
  eventType     CallEventType
  timestampMs   Int           // Relative ms since call start
  durationMs    Int?          // How long the stage took (e.g. STT processing time)
  metadata      Json?         // Stage-specific data (e.g. { model: "nova-3", transcript: "..." })
  error         String?       @db.Text
  createdAt     DateTime      @default(now())

  call          Call          @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@index([callId, eventType])
  @@index([eventType])
  @@index([createdAt])
}

// ─── Feature Flags (Per-Tenant Rollout Control) ─────────────────────────────

model FeatureFlag {
  id              String       @id @default(cuid())
  organizationId  String       @default("__GLOBAL__") // "__GLOBAL__" = applies to all tenants
  name            String       // e.g. "use_new_pipeline", "enable_fallbacks"
  enabled         Boolean      @default(false)
  metadata        Json?        // Additional config like rollout percentage
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([name])
  @@index([organizationId])
}

// ─── Campaign Execution Engine (Persistent State) ──────────────────────────

model Campaign {
  id                  String         @id @default(cuid())
  organizationId      String
  agentId             String
  name                String
  description         String?        @db.Text
  status              CampaignStatus @default(DRAFT)
  concurrency         Int            @default(2)
  maxRetries          Int            @default(2)
  retryDelaySeconds   Int            @default(30)
  callDelaySeconds    Int            @default(2)
  startedAt           DateTime?
  completedAt         DateTime?
  pausedAt            DateTime?
  totalContacts       Int            @default(0)
  completedContacts   Int            @default(0)
  failedContacts      Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent               Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leads               CampaignLead[]

  @@index([organizationId])
  @@index([agentId])
  @@index([status])
  @@index([organizationId, status])
  @@index([createdAt])
}

model CampaignLead {
  id              String     @id @default(cuid())
  campaignId      String
  organizationId  String
  name            String
  phoneNumber     String     // E.164 formatted (+91XXXXXXXXXX)
  rawPhoneNumber  String?    // Original input for audit
  language        String?
  customData      Json?      // Lead-specific variables e.g. { budget: "₹2Cr", location: "Gachi" }
  status          LeadStatus @default(PENDING)
  retriesCount    Int        @default(0)
  maxRetries      Int        @default(2)
  callId          String?    // Internal call ID
  vobizCallId     String?    // Provider call ID (ac_xxx)
  durationSeconds Int        @default(0)
  outcome         String?    // "Interested", "Not Interested", "Callback", "No Answer", etc.
  summary         String?    @db.Text
  error           String?
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  campaign        Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phoneNumber])   // Prevent duplicate contacts within a campaign
  @@index([campaignId])
  @@index([organizationId])
  @@index([status])
  @@index([campaignId, status])
  @@index([phoneNumber])
}
